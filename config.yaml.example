# =============================================================================
# dbs-vector — Example Configuration
# -----------------------------------------------------------------------------
# Copy to config.yaml and edit. Validation runs on the first CLI command:
#   uv run dbs-vector ingest ./docs/ --type md
#
# Override config path:  --config-file <path>  or  DBS_CONFIG_FILE=<path>
#
# Documentation:
#   docs/README_PROFILES.md   — profiles, memory math, workload recipes, audit
#   docs/README_granite.md    — Granite R2 specifics (no prefixes, why)
#   docs/README_MCP.md        — MCP tool naming + per-engine tool surface
#   docs/README_EMBEDDINGS.md — model contracts and supported models
# =============================================================================


# -----------------------------------------------------------------------------
# system:  global runtime settings (one block, no nesting)
# -----------------------------------------------------------------------------
system:
  # LanceDB on-disk location. Change to keep separate indexes per project.
  db_path: "./lancedb_dbs_vector"

  # IVF_PQ vector search probe count. Higher = better recall, slower queries.
  nprobes: 20

  # Loguru level. DEBUG | INFO | WARNING | ERROR.
  log_level: "INFO"

  # Emit logs as JSON lines. Useful when piping into log aggregators.
  log_serialize: false

  # Metal memory budget override (GB). Auto-detected on Apple Silicon.
  # Set explicitly if auto-detection over-reports, or to cap headroom.
  # memory_budget_gb: 22.0


# -----------------------------------------------------------------------------
# profiles:  hardware-sensitive tuning knobs
# -----------------------------------------------------------------------------
# Five knobs per profile (every engine references one profile by name):
#   max_token_length      tokenizer cap; must be ≤ model contract max
#                         (Gemma: 2048, Granite R2: 32768)
#   chunk_max_chars       character budget per chunk; 0 = atomic (one record/chunk)
#                         NOTE: for document (markdown) engines this now only governs
#                         the .txt fallback path; markdown chunks are sized by the
#                         token budgets below.
#   batch_size            chunks per MLX forward pass (memory vs. throughput)
#   chunk_target_tokens   target tokens per markdown chunk; document engines REQUIRE
#                         this > 0; SQL profiles omit it (or leave it at default 0)
#   chunk_max_tokens      hard per-chunk token ceiling; must satisfy
#                         chunk_target_tokens ≤ chunk_max_tokens ≤ max_token_length;
#                         document engines REQUIRED > 0; SQL profiles omit it
#
# Pick a recipe below, copy it, or write your own — see workload recipes
# and audit script in docs/README_PROFILES.md.
# -----------------------------------------------------------------------------
profiles:
  # Gemma defaults — short-context, instruction-tuned model.
  gemma-md:           {max_token_length: 2048,  chunk_max_chars: 1000, batch_size: 64, chunk_target_tokens: 512, chunk_max_tokens: 1024}
  gemma-sql-atomic:   {max_token_length: 2048,  chunk_max_chars: 0,    batch_size: 64}

  # Granite R2 long-form prose recipe (large chunks, modest batches).
  granite-md-large:   {max_token_length: 16384, chunk_max_chars: 6000, batch_size: 8, chunk_target_tokens: 1536, chunk_max_tokens: 3072}

  # Granite R2 fragmented techdoc recipe — finer chunks, throughput-optimized.
  granite-md-medium:  {max_token_length: 2048,  chunk_max_chars: 3000, batch_size: 16, chunk_target_tokens: 768, chunk_max_tokens: 1536}

  # Granite R2 SQL atomic — one record per chunk; raise batch_size for throughput.
  granite-sql-atomic: {max_token_length: 8192,  chunk_max_chars: 0,    batch_size: 32}


# -----------------------------------------------------------------------------
# engines:  per-deployment search engine definitions
# -----------------------------------------------------------------------------
# Each engine becomes:
#   • A LanceDB table          (table_name)
#   • An MCP tool              (search_<engine_name>, dashes → underscores)
#   • A CLI --type alias       (uv run dbs-vector ingest|search --type <name>)
#
# Engine names must match ^[a-z0-9][a-z0-9_-]*$  (validator Rule 6).
# resolved_family must be a known FamilyKeyRegistry key  (validator Rule 7).
# -----------------------------------------------------------------------------
engines:

  # ----- Markdown / prose, Gemma (instruction-tuned, asymmetric retrieval) ----
  md:
    description:    "Semantic search over Markdown documentation chunks. Returns the top-K most similar passages (by cosine similarity, not recency or size)."
    model:          "gemma-bf16"          # ModelRegistry key (core/model_registry.py)
    mapper_type:    "document"            # storage schema for document chunks
    chunker_type:   "document"            # markdown-it semantic chunker
    table_name:     "knowledge_vault"     # LanceDB table; unique per (model × workflow)
    workflow:       "md_search"           # workflow label written into every chunk
    tuning_profile: "gemma-md"            # references profiles: block above
    # Optional per-engine content exclusion (default: none). Built-ins:
    # excalidraw (skips drawing files/blocks), compressed_json (drops blobs).
    exclusion_filters: [excalidraw, compressed_json]
    # Gemma is task-instruction-tuned: prefixes project queries and passages
    # into a shared task-conditional subspace. REQUIRED for Gemma.
    passage_prefix: "title: none | text: "
    query_prefix:   "task: search result | query: "

  # ----- Markdown / prose, Granite R2 (symmetric bi-encoder) ------------------
  md-granite:
    description:    "Semantic search over Markdown documentation chunks (Granite embeddings). Returns the top-K most similar passages by cosine similarity."
    model:          "granite-r2"
    mapper_type:    "document"
    chunker_type:   "document"
    table_name:     "knowledge_vault_granite"   # MUST differ from gemma's table
    workflow:       "md_search_granite"
    tuning_profile: "granite-md-large"
    exclusion_filters: [excalidraw, compressed_json]
    # Granite R2 is NOT instruction-tuned. Leave prefixes empty.
    # Rationale: docs/README_granite.md (model card ships empty prompt slots).

  # ----- A/B variant: same model, finer chunks ------------------------------
  # Add a new engine row → automatically becomes MCP tool `search_md_granite_medium`.
  # No source code changes required (validator Rule 6 enforces the name pattern).
  md-granite-medium:
    description:    "Granite R2, finer chunks (A/B candidate vs md-granite)"
    model:          "granite-r2"
    mapper_type:    "document"
    chunker_type:   "document"
    table_name:     "knowledge_vault_granite_medium"   # MUST differ from baseline
    workflow:       "md_search_granite"
    tuning_profile: "granite-md-medium"
    exclusion_filters: [excalidraw, compressed_json]

  # ----- SQL slow-query log, local DuckDB source -----------------------------
  sql:
    description:    "Semantic search over the top-N most impactful slow-query fingerprints from a local DuckDB log. Ranks by cosine similarity to the query string, not by execution time or call count. Filters (optional, applied as AND prefilters before similarity ranking): `min_time` — minimum cumulative `execution_time_ms` in milliseconds (e.g. 60000 = 60 s of total accumulated time across all calls of a fingerprint, not per-call avg); `min_lock_time` — minimum cumulative `lock_time_sec` in seconds; `table_filter` — restrict to fingerprints whose `tables` list contains the given table name."
    model:          "gemma-bf16"
    mapper_type:    "sql"                 # SQL schema (raw_query, exec time, calls, ts)
    chunker_type:   "duckdb"              # reads slow-log DuckDB files
    table_name:     "query_vault"
    workflow:       "sql_clustering"
    tuning_profile: "gemma-sql-atomic"
    # Symmetric clustering prefix (queries and passages encoded the same way).
    passage_prefix: "task: clustering | query: "
    query_prefix:   "task: clustering | query: "
    # Optional override of the default 15-day aggregation query:
    # duckdb_query: >
    #   SELECT fingerprint_id AS id, sanitized_sql AS text, db AS source,
    #          SUM(query_time_sec) * 1000 AS execution_time_ms, COUNT(*) AS calls
    #   FROM slow_logs GROUP BY fingerprint_id ORDER BY execution_time_ms DESC

  # ----- SQL slow-query log, remote HTTP API source --------------------------
  # See docs/README_REMOTE_SQL_API.md for the expected API contract.
  # Treat this file as a secret if api_key is non-empty (gitignore config.yaml).
  sql-api:
    description:    "Semantic search over the top-N most impactful slow-query fingerprints from a remote slow-log API. Returns up to `limit` results ranked by cosine similarity to the query string (NOT by execution_time_ms or calls). Filters (optional, applied as AND prefilters before similarity ranking): `min_time` — minimum cumulative `execution_time_ms` in milliseconds (e.g. 60000 = 60 s of total accumulated time across all calls of a fingerprint, not per-call avg); `min_lock_time` — minimum cumulative `lock_time_sec` in seconds; `table_filter` — restrict to fingerprints whose `tables` list contains the given table name. The response header reports 'Showing N of M results that matched your filters' so callers can tell when results are similarity-truncated."
    model:          "gemma-bf16"
    mapper_type:    "sql"
    chunker_type:   "api"                 # paginated REST API source
    table_name:     "query_vault"
    workflow:       "sql_clustering"
    tuning_profile: "gemma-sql-atomic"
    passage_prefix: "task: clustering | query: "
    query_prefix:   "task: clustering | query: "
    api_base_url:   "http://localhost:8080/api/v1"   # version-prefixed endpoint
    api_key:        ""                                # bearer token; "" disables auth header
    api_page_size:  200                               # records per GET request (max 1000)
    api_since_days: 15                                # fetch queries with latest_ts within N days
    api_timeout_sec: 30                               # per-request HTTP timeout
    api_min_execution_ms: 0                           # skip queries below this cumulative exec time
    api_database:   ""                                # restrict to one db; "" fetches all

  # ----- SQL slow-query log, Granite R2 (no prefixes) -----------------------
  sql-granite:
    description:    "Semantic search over the top-N most impactful slow-query fingerprints from a local DuckDB log (Granite embeddings). Ranks by cosine similarity to the query string, not by execution time or call count. Filters (optional, applied as AND prefilters before similarity ranking): `min_time` — minimum cumulative `execution_time_ms` in milliseconds (e.g. 60000 = 60 s of total accumulated time across all calls of a fingerprint, not per-call avg); `min_lock_time` — minimum cumulative `lock_time_sec` in seconds; `table_filter` — restrict to fingerprints whose `tables` list contains the given table name."
    model:          "granite-r2"
    mapper_type:    "sql"
    chunker_type:   "duckdb"
    table_name:     "query_vault_granite"
    workflow:       "sql_clustering_granite"
    tuning_profile: "granite-sql-atomic"
    # Empty prefixes (Granite R2 — see docs/README_granite.md).

  # ----- SQL slow-query log, Granite R2 + remote API ------------------------
  sql-api-granite:
    description:    "Semantic search over the top-N most impactful slow-query fingerprints from a remote slow-log API (Granite embeddings). Returns up to `limit` results ranked by cosine similarity to the query string (NOT by execution_time_ms or calls). Filters (optional, applied as AND prefilters before similarity ranking): `min_time` — minimum cumulative `execution_time_ms` in milliseconds (e.g. 60000 = 60 s of total accumulated time across all calls of a fingerprint, not per-call avg); `min_lock_time` — minimum cumulative `lock_time_sec` in seconds; `table_filter` — restrict to fingerprints whose `tables` list contains the given table name. The response header reports 'Showing N of M results that matched your filters' so callers can tell when results are similarity-truncated."
    model:          "granite-r2"
    mapper_type:    "sql"
    chunker_type:   "api"
    table_name:     "query_vault_granite_api"
    workflow:       "sql_clustering_granite"
    tuning_profile: "granite-sql-atomic"
    api_base_url:   "http://localhost:8080/api/v1"
    api_key:        ""
    api_page_size:  200
    api_since_days: 15
    api_timeout_sec: 30
    api_min_execution_ms: 0
    api_database:   ""


# =============================================================================
# Adding a new engine
# -----------------------------------------------------------------------------
# 1. Pick (or define) a `tuning_profile:` from the profiles: block above.
# 2. Add an engine entry under engines: with a unique table_name.
# 3. Restart `dbs-vector mcp` — the new MCP tool `search_<engine_name>` is
#    auto-registered, and `list_engines` will report it as `loaded: true`.
#
# Adding a new model contract (e.g., a new embedder) requires a code change
# in src/dbs_vector/core/model_registry.py — see docs/README_EMBEDDINGS.md.
# =============================================================================
